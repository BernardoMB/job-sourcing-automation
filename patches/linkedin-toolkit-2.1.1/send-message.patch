 /**
+ * Job Sourcer patch: the existing 1:1 conversation with a person, as a `conversationUrn`, or ''.
+ *
+ * Matched on the person's member id as the conversation list reports it (the same `ACoAA...` id an
+ * agent passes as publicId), so no profile lookup is needed. LinkedIn answers 20 conversations per
+ * request, so a quiet thread falls off the first page: the toolkit's own inbox mirror (every
+ * conversation it has listed) is searched first, then LinkedIn page by page.
+ */
+export async function findConversationWith(ids) {
+  const want = new Set((ids || []).filter(Boolean).map((x) => String(x).split(':').pop()));
+  if (!want.size) return '';
+  const mailboxUrn = await selfProfileUrn();
+  const matches = (t) =>
+    (t.participants || []).length === 1 &&
+    want.has(String(t.participants[0].publicId || '').split(':').pop());
+  try {
+    const mirrored = (await storageGet(K.THREADS, [])) || [];
+    const hit = mirrored.filter(matches).sort((a, b) => (b.lastMessageAt || 0) - (a.lastMessageAt || 0))[0];
+    if (hit && hit.threadId) return conversationUrn(mailboxUrn, hit.threadId);
+  } catch {
+    /* no mirror: ask LinkedIn */
+  }
+  let before;
+  for (let page = 0; page < 6; page += 1) {
+    let threads;
+    try {
+      ({ threads } = await getConversations({ count: 20, createdBefore: before }));
+    } catch {
+      return '';
+    }
+    const hit = (threads || []).find(matches);
+    if (hit && hit.threadId) return conversationUrn(mailboxUrn, hit.threadId);
+    if (!threads || threads.length < 20) return '';
+    const oldest = Math.min(...threads.map((t) => t.lastMessageAt || Date.now()));
+    if (!oldest || oldest === before) return '';
+    before = oldest;
+  }
+  return '';
